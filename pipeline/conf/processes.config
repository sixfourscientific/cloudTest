
process {

    /* SETUP */

    debug = { params.DEBUG }

    errorStrategy  = 'finish'
    
    beforeScript = {

        "mkdir -p TASK_TMP" }

    afterScript = {

        // archive task files

        def runDir  = workflow.workDir.parent
        
        def uriDir  = runDir.toUriString()
        
        def logDir  = params.logDir

        def taskDir = "$uriDir/$logDir/tasks/${task.process.replace(':','.')}/$task.tag"
 
        """     

        # copy task logs
        for LOG in .command*; do

            TASKLOG="${taskDir}/${task.tag}.\${LOG##*.}"

            # to s3 archive (using .command.run function)
            if [[ "${task.executor}" == "awsbatch" ]]; then

                if ! command -v aws &> /dev/null; then    
                    echo "WARNING: skipping task logs (aws command unavailable)"
                else
                    nxf_s3_download \$LOG \$TASKLOG
                fi

            # to gs archive (using .command.run function)
            elif [[ "${task.executor}" == "google-batch" ]]; then

                if ! command -v gsutil &> /dev/null; then    
                    echo "WARNING: skipping task logs (gsutil command unavailable)"
                else
                    gsutil -q cp -r \$LOG \$TASKLOG
                fi
                
            # to local archive
            else

                mkdir -p "$taskDir"

                cp -a \$LOG \$TASKLOG

            fi

        done

        """.stripIndent() }

    }
